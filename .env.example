# Copy to .env and fill in. Never commit .env.
PORT=1631

# SES SMTP
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your-ses-smtp-username
MAIL_PASSWORD=your-ses-smtp-password
MAIL_FROM=info@ajobzio.com
MAIL_STARTTLS=true

# Inbox that receives quote requests
MAIL_TO=support@ajobzio.com

# Google Maps Platform key (Places API (New) only). Used server-side; required for location checks.
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
# Only if the key has a website (referrer) restriction; must match an allowed referrer.
GOOGLE_MAPS_REFERER=ajobzio.com
# Optional browser key for the "Choose on map" picker (Maps JavaScript API). Restrict it to your site's
# referrers. If empty, GOOGLE_MAPS_API_KEY is sent to the browser instead, so that key must then allow
# Maps JavaScript API and have a website restriction.
GOOGLE_MAPS_BROWSER_KEY=

# Parcel delivery pricing (rupees, before GST). Kept on the server so visitors can't see or change it.
# Each vehicle: a base fare that covers the first INCLUDED_KM, then PER_KM for every extra km.
PRICE_TWO_WHEELER_BASE_FARE=49
PRICE_TWO_WHEELER_INCLUDED_KM=2
PRICE_TWO_WHEELER_PER_KM=15
PRICE_THREE_WHEELER_BASE_FARE=149
PRICE_THREE_WHEELER_INCLUDED_KM=2
PRICE_THREE_WHEELER_PER_KM=25
PRICE_FOUR_WHEELER_BASE_FARE=299
PRICE_FOUR_WHEELER_INCLUDED_KM=2
PRICE_FOUR_WHEELER_PER_KM=35
# Your margin in percent, built into the base fare and per-km rate (not shown as its own line).
PRICE_MARGIN_PERCENT=0
# Discount in percent, taken off the fare before GST and shown on the bill. 0 for no discount.
DISCOUNT_PERCENT=5
# GST in percent, shown on the bill as half CGST + half SGST.
GST_PERCENT=18

# Ajobzio Payments for "Pay now". UAT (test) service and tenant shown; switch both for live payments.
# Pay now stays disabled ("Coming soon") until this is true.
PAYMENTS_ENABLED=false
PAYMENTS_BASE_URL=https://payments-uat.ajobzio.com
PAYMENTS_TENANT_ID=1001
