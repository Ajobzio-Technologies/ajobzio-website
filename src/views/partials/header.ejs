<% const pin = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>'; -%>
  <header>
    <a class="brand" href="/" aria-label="Ajobzio">
      <img class="logo" src="/images/brand/logo.png" alt="Ajobzio">
    </a>
    <nav class="nav-links" aria-label="Main">
      <a href="/#services">Services</a>
      <a href="/#how">How it works</a>
      <a href="/#nearby">Providers</a>
      <a href="/support">Help</a>
    </nav>
    <details class="areas">
      <summary aria-label="Areas we serve: <%= districts.length %> districts">
        <%- pin %>
        <span class="areas-label"><span class="areas-rotor"><% districts.forEach((district, i) => { %><b<%- i === 0 ? ' class="is-on"' : '' %>><%= district %></b><% }) %></span></span>
      </summary>
      <div class="areas-panel">
        <div class="areas-head">
          <div>
            <h2>Where we operate</h2>
            <p><%= districts.length %> districts across <%= state %></p>
          </div>
          <span class="areas-live"><i></i>Live</span>
        </div>
        <ul class="areas-list">
<% districts.forEach((district, i) => { -%>
          <li style="--i: <%= i %>"<%- i === 0 ? ' class="is-current"' : '' %>><span><%- pin %></span><%= district %><em>Active</em></li>
<% }) -%>
        </ul>
        <div class="areas-soon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          More districts coming soon
        </div>
      </div>
    </details>
    <a class="nav-btn" href="/track">
      <span class="track-label">Track order</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#087B69" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-label="Open menu">
      <svg class="open-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </header>
