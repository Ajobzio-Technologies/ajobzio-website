<%# "Choose on map" popup (js/home/map-picker.js). Shared by the home page and the quote page. -%>
<dialog class="contact-dialog map-dialog" id="mapDialog" aria-labelledby="mapTitle">
  <h2 id="mapTitle">Choose on map</h2>
  <p class="contact-sub">Search your locality, then move the map so the pin sits on the exact spot.</p>
  <label class="field map-search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <span><span>Search locality</span><input id="mapSearch" placeholder="Search a locality or landmark"></span>
  </label>
  <div class="map-wrap">
    <div class="map-canvas" id="mapCanvas"></div>
    <svg class="map-pin" width="36" height="44" viewBox="0 0 36 44" aria-hidden="true"><path d="M18 43s15-13.2 15-25A15 15 0 0 0 3 18c0 11.8 15 25 15 25Z" fill="#1666D8" stroke="#fff" stroke-width="2"/><circle cx="18" cy="18" r="5.5" fill="#fff"/></svg>
    <button type="button" class="map-locate" id="mapLocate">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
      Use my current location
    </button>
  </div>
  <p class="parcel-note contact-status" id="mapStatus" role="status" hidden></p>
  <div class="contact-actions">
    <button type="button" class="compare ghost" id="mapCancel">Cancel</button>
    <button type="button" class="compare" id="mapConfirm">Confirm location</button>
  </div>
</dialog>
