<%- include("../partials/head", { styles: ["/css/track.css"], scripts: ["/js/pages/track.js"] }) %>

  <main class="track-page is-empty" id="trackPage">
    <section class="track-hero">
      <div class="track-hero-copy">
        <h1>Track your parcel</h1>
        <p class="track-sub">Enter your tracking ID to get real-time updates on your parcel delivery.</p>
        <form class="track-search" id="trackForm" novalidate>
          <label class="track-field">
            <%- icon('box', 20) %>
            <input id="orderId" name="orderId" autocomplete="off" spellcheck="false" maxlength="30" placeholder="Enter tracking ID (e.g. AJB-10234)" aria-label="Tracking ID" required>
          </label>
          <button type="submit" class="track-submit" id="trackSubmit"><%- icon('search', 18) %> Track parcel</button>
        </form>
        <p class="track-hint">You can find the tracking ID in your booking confirmation (SMS, WhatsApp or email).</p>
      </div>
    </section>

    <div class="track-result" id="trackResult" role="status" aria-live="polite" hidden></div>

    <!-- Icons for the result card, copied in by js/pages/track.js. -->
    <template id="trackIcons">
<% ['check', 'truck', 'clock', 'box', 'phone', 'whatsapp', 'headset', 'arrow', 'pin', 'user', 'tag', 'summary'].forEach((name) => { -%>
      <span data-icon="<%= name %>"><%- icon(name, 20) %></span>
<% }) -%>
      <span data-icon="home"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/></svg></span>
      <span data-icon="tick"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
      <span data-icon="x"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></span>
      <span data-icon="star"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2-4.6-4.4 6.3-.9Z"/></svg></span>
    </template>
  </main>

<%- include("../partials/footer") %>
