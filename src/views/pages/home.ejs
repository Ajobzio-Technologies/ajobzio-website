    <section class="reviews" id="reviews">
      <div class="pill"><i></i> Real jobs, real reviews</div>
      <h2>People use Ajobzio to get on with life</h2>
      <div class="reviews-line">
        <p>From the thing that has to arrive today to the job that has waited all month.</p>
        <div class="reviews-score"><b>4.8 / 5</b><small>from 3,840 verified reviews</small></div>
      </div>
      <div class="review-grid">
        <figure class="review">
          <div class="review-top">
            <span class="review-stars"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#E2A23B" stroke-width="2.2" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg> 5.0</span>
