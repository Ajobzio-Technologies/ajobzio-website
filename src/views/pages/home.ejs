          <div class="review-top">
            <span class="review-stars"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#E2A23B" stroke-width="2.2" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg> 5.0</span>
            <span class="review-quote" aria-hidden="true">”</span>
