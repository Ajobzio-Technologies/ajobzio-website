<%- include("../partials/head", { styles: ["/css/home.css"], scripts: ["/js/pages/home.js"] }) %>

  <main>
    <section class="hero mode-parcel" id="hero">
      <div class="hero-bg hero-bg-parcel" aria-hidden="true"></div>
      <div class="hero-bg hero-bg-service" aria-hidden="true"></div>
      <div class="hero-modes">
        <div class="modes" role="tablist" aria-label="Choose a service">
          <span class="modes-pill" aria-hidden="true"></span>
          <button type="button" class="active" data-mode="parcel" role="tab" aria-selected="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7.5 12 3l9 4.5-9 4.5L3 7.5Z"/><path d="M3 7.5V16.5L12 21l9-4.5V7.5"/><path d="M12 12v9"/></svg>
            Parcel delivery
          </button>
          <button type="button" data-mode="service" role="tab" aria-selected="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            Local service
          </button>
        </div>
      </div>
      <div class="hero-stage">
        <div class="hero-grid" id="heroGrid">
          <div>
            <div class="badge"><i></i><span id="heroBadge">Parcel delivery, made simple</span></div>
            <h1 id="heroTitle">Send it. Track it. Get it delivered.</h1>
            <p class="lede" id="heroLede">Compare trusted local delivery partners, choose the right vehicle for your parcel, and see clear pricing — all in minutes.</p>
            <form class="quote" id="quote">
            <div class="quote-body parcel-mode" id="parcelMode">
                  <div class="parcel-face" id="parcelStep1">
                    <p class="step-meta" id="stepMeta1">Step 1 of 2</p>
                    <div class="center-block vehicle-pick" id="vehiclePick">
                      <p class="block-label">Vehicle type</p>
                      <div class="vehicles" id="vehicleList" role="radiogroup" aria-label="Vehicle type"></div>
                    </div>
                    <div class="center-block" id="typeCenter">
                      <p class="block-label">Parcel type</p>
                      <div class="field when-field" id="typeField">
                        <span>
                          <span>Choose parcel type</span>
                          <button type="button" class="when-btn" id="typeBtn" aria-haspopup="listbox" aria-expanded="false">
                            <span id="typeValue">Non-Document</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8AA0A4" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                          </button>
                        </span>
                        <ul class="when-menu" id="typeMenu" role="listbox" hidden>
                          <li><button type="button" data-value="DOCUMENT">Document</button></li>
                          <li><button type="button" class="on" data-value="NON_DOCUMENT">Non-Document</button></li>
                        </ul>
                      </div>
                    </div>
                    <div class="address-row">
                      <label class="field">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
                        <span><span id="fromLabel">Pickup location</span><input id="from" placeholder="Search pickup area"></span>
                      </label>
                      <label class="field">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
                        <span><span id="toLabel">Delivery location</span><input id="to" placeholder="Search delivery area"></span>
                      </label>
                    </div>
                  </div>
                  <div class="parcel-face" id="parcelStep2" hidden>
                    <p class="step-meta">Step 2 of 2</p>
                    <div class="fields">
                      <div class="field when-field" id="weightField">
                        <span>
                          <span>Weight per box</span>
                          <button type="button" class="when-btn" id="weightBtn" aria-haspopup="listbox" aria-expanded="false">
                            <span id="weightValue">1 kg</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8AA0A4" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                          </button>
                        </span>
                        <ul class="when-menu" id="weightMenu" role="listbox" hidden></ul>
                      </div>
                      <div class="field when-field" id="qtyField">
                        <span>
                          <span>Quantity</span>
                          <button type="button" class="when-btn" id="qtyBtn" aria-haspopup="listbox" aria-expanded="false">
                            <span id="qtyValue">1 box</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8AA0A4" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                          </button>
                        </span>
                        <ul class="when-menu" id="qtyMenu" role="listbox" hidden></ul>
                      </div>
                    </div>
                    <p class="total-line" id="totalWeightLine"><span>Total weight:</span> 1 kg</p>
                    <div class="dims" id="parcelDims">
                      <div class="dims-head">
                        <p class="block-label">Size per box (cm)</p>
                        <button type="button" class="copy-dims" id="copyDims" hidden>Copy Box 1 to all</button>
                      </div>
                      <div class="box-cols" aria-hidden="true"><span></span><span>Length</span><span>Width</span><span>Height</span></div>
                      <div class="box-list" id="boxList"></div>
                      <p class="dims-hint" id="dimsHint" hidden></p>
                    </div>
                    <p class="parcel-note upgrade" id="upgradeNote" hidden></p>
                    <p class="parcel-note error" id="capacityError" hidden></p>
                  </div>
            </div>

            <div class="quote-body service-mode" id="serviceMode" hidden>
                <label class="field">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z"/></svg>
                  <span><span>Service</span><input id="serviceNeed" value="Home cleaning" list="serviceList" autocomplete="off" placeholder="What do you need?"></span>
                  <datalist id="serviceList">
                    <option value="Home cleaning"></option>
                    <option value="Plumbing"></option>
                    <option value="Electrical work"></option>
                    <option value="AC service &amp; repair"></option>
                    <option value="Appliance repair"></option>
                    <option value="Carpentry"></option>
                    <option value="Painting"></option>
                    <option value="Pest control"></option>
                  </datalist>
                </label>
                <label class="field">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
                  <span><span>Area</span><input id="serviceArea" autocomplete="off" placeholder="Search your locality"></span>
                </label>
                <div class="field when-field" id="whenField">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                  <span><span>When</span>
                    <button type="button" class="when-btn" id="whenBtn" aria-haspopup="listbox" aria-expanded="false">
                      <span id="whenValue">Morning, 6 AM – 11 AM</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8AA0A4" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </span>
                  <ul class="when-menu" id="whenMenu" role="listbox" hidden>
                    <li><button type="button" class="on" data-value="Morning, 6 AM – 11 AM" aria-label="Morning, 6 AM to 11 AM"><span><b>Morning</b><small>6 AM to 11 AM</small></span></button></li>
                    <li><button type="button" data-value="Afternoon, 11 AM – 4 PM" aria-label="Afternoon, 11 AM to 4 PM"><span><b>Afternoon</b><small>11 AM to 4 PM</small></span></button></li>
                    <li><button type="button" data-value="Evening, 4 PM – 9 PM" aria-label="Evening, 4 PM to 9 PM"><span><b>Evening</b><small>4 PM to 9 PM</small></span></button></li>
                    <li><button type="button" data-value="Night, after 9 PM" aria-label="Night, after 9 PM"><span><b>Night</b><small>After 9 PM</small></span></button></li>
                  </ul>
                </div>
                <div class="field date-field" id="dateField">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                  <span>
                    <span>Date</span>
                    <button type="button" class="when-btn" id="dateBtn" aria-haspopup="dialog" aria-expanded="false">
                      <span id="dateValue">Immediate</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8AA0A4" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                  </span>
                  <div class="date-menu" id="dateMenu" role="dialog" aria-label="Choose a date" hidden>
                    <button type="button" class="date-choice on" data-kind="immediate">
                      <span><b>Immediate</b><small>A worker can come as soon as possible</small></span>
                    </button>
                    <button type="button" class="date-choice" data-kind="dates">
                      <span><b>Choose dates</b><small>A preferred start day, plus one backup within 7 days</small></span>
                    </button>
                    <div class="date-pickers" id="datePickers" hidden>
                      <p class="date-step">Preferred date<small>The day you most want the worker to start</small></p>
                      <div id="prefCal"></div>
                      <p class="date-step">Backup date<small id="backupHint">Choose the preferred date first. The backup has to be within the next 7 days.</small></p>
                      <div class="backup-days" id="backupDays"></div>
                    </div>
                  </div>
                </div>
            </div>

            <p class="parcel-note upgrade place-error" id="placeError" role="status" hidden></p>
            <div class="parcel-row solo" id="parcelRow">
              <button type="button" class="compare ghost" id="backBtn" hidden>← Back</button>
              <button class="compare" id="compareBtn" type="button">Next →</button>
            </div>
            <div class="checks" id="heroChecks">
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10A88B" stroke-width="2.4"><path d="m5 12 5 5L20 7"/></svg> No account required</span>
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10A88B" stroke-width="2.4"><path d="m5 12 5 5L20 7"/></svg> Clear pricing</span>
              <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10A88B" stroke-width="2.4"><path d="m5 12 5 5L20 7"/></svg> Reliable delivery</span>
            </div>
          </form>
          </div>
        </div>
      </div>
    </section>
    <section class="services" id="services">
      <div class="pill"><i></i> One search, plenty of help</div>
      <h2>What can we help with?</h2>
      <div class="services-line">
        <p>Search practical local services and compare providers without forms, phone tag or an account.</p>
        <a class="browse" href="#services">Browse all services →</a>
      </div>
      <div class="svc-grid">
        <a class="svc" href="#services">
          <span class="svc-icon" style="background:#EAF4FF;color:#1666D8"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7.5 12 3l9 4.5-9 4.5L3 7.5Z"/><path d="M3 7.5V16.5L12 21l9-4.5V7.5"/><path d="M12 12v9"/></svg></span>
          <span class="go">↗</span>
          <h3>Courier &amp; parcels</h3>
          <p>Same-day, next-day and scheduled delivery.</p>
          <b style="color:#1666D8">From ₹149</b>
        </a>
        <a class="svc is-soon" href="#services">
          <span class="svc-icon" style="background:#DDF7EF;color:#087B69"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg></span>
          <span class="go">↗</span>
          <h3>Moving help</h3>
          <p>Vans, lifting help and small home moves.</p>
          <b class="soon-tag">Coming soon</b>
        </a>
        <a class="svc is-soon" href="#services">
          <span class="svc-icon" style="background:#FFF0D9;color:#C4842A"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/><circle cx="12" cy="12" r="3"/></svg></span>
          <span class="go">↗</span>
          <h3>Cleaning</h3>
          <p>Trusted help for homes, offices and end-of-tenancy.</p>
          <b class="soon-tag">Coming soon</b>
        </a>
        <a class="svc is-soon" href="#services">
          <span class="svc-icon" style="background:#F1EBFF;color:#6C4CCF"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 0-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 0 0 5.6-5.6l-2.2 2.2-1.6-1.6 2.2-2.2Z"/></svg></span>
          <span class="go">↗</span>
          <h3>Repairs</h3>
          <p>Handypeople for fixes, fitting and maintenance.</p>
          <b class="soon-tag">Coming soon</b>
        </a>
        <a class="svc is-soon" href="#services">
          <span class="svc-icon" style="background:#FDECEA;color:#C75B44"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span>
          <span class="go">↗</span>
          <h3>Errands</h3>
          <p>Collections, shopping, returns and local tasks.</p>
          <b class="soon-tag">Coming soon</b>
        </a>
        <a class="svc is-soon" href="#services">
          <span class="svc-icon" style="background:#E5F7F3;color:#0E9B86"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 11V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/><path d="M4 14h16v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4Z"/><path d="M4 14a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3"/></svg></span>
          <span class="go">↗</span>
          <h3>Furniture assembly</h3>
          <p>Flat-pack assembly by rated local experts.</p>
          <b class="soon-tag">Coming soon</b>
        </a>
      </div>
    </section>
    <section class="nearby" id="nearby">
      <div class="pill"><i></i> Near you now</div>
      <div class="nearby-line">
        <div>
          <h2>Trusted help around the corner</h2>
          <p>Parcel couriers are ready now. Cleaning, repairs and other local help are coming soon.</p>
        </div>
        <button type="button" class="area-select" aria-label="Change area">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1666D8" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
          Brixton · within 3 miles
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
      <div class="pro-grid">
        <article class="pro">
          <div class="pro-media">
            <img src="/images/hero/parcel-delivery/Modern Delivery Hero Banner.png" alt="Courier with a cargo bike" loading="lazy">
            <span class="pro-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#087B69" stroke-width="2.2" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> Top courier</span>
          </div>
          <div class="pro-body">
            <div class="pro-head">
              <h3>Swift &amp; Kind Couriers</h3>
              <span class="pro-rating"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E2A23B" stroke-width="2" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg> 4.9 <small>(426)</small></span>
            </div>
            <div class="pro-cat">Same-day courier</div>
            <div class="pro-meta">0.8 miles away · replies in 3 min</div>
            <div class="pro-foot">
              <div class="pro-price"><small>Typical price</small><b>From ₹149</b></div>
              <a class="pro-cta" href="#hero">Get a quote <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
        <article class="pro is-soon">
          <div class="pro-media">
            <img src="/images/hero/local-services/Professional Service Team Banner.png" alt="Home helper holding cleaning supplies" loading="lazy">
            <span class="pro-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#087B69" stroke-width="2.2" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> Coming soon</span>
          </div>
          <div class="pro-body">
            <div class="pro-head">
              <h3>Maya’s Home Help</h3>
            </div>
            <div class="pro-cat">Cleaning &amp; errands</div>
            <div class="pro-meta">Joining Ajobzio soon</div>
            <div class="pro-foot">
              <div class="pro-price"><small>Expected from</small><b>₹399/hr</b></div>
              <span class="pro-cta is-soon">Coming soon</span>
            </div>
          </div>
        </article>
        <article class="pro is-soon">
          <div class="pro-media">
            <img src="/images/content/skilled-professionals-cityscape.png" alt="Handyman with a toolbox" loading="lazy">
            <span class="pro-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#087B69" stroke-width="2.2" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> Coming soon</span>
          </div>
          <div class="pro-body">
            <div class="pro-head">
              <h3>Northside Handy Co.</h3>
            </div>
            <div class="pro-cat">Repairs &amp; assembly</div>
            <div class="pro-meta">Joining Ajobzio soon</div>
            <div class="pro-foot">
              <div class="pro-price"><small>Expected from</small><b>₹499</b></div>
              <span class="pro-cta is-soon">Coming soon</span>
